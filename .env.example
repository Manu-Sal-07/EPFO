# ==============================================================================
# PF COMPASS — Environment Variable Reference
# ==============================================================================
# Copy this file to .env and fill in values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=development         # development | staging | production

# ------------------------------------------------------------------------------
# DATABASE
# Locally: set by docker-compose.yml
# Render:  provided automatically from the managed PostgreSQL service
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://pfcompass:changeme@localhost:5432/pfcompass

# ------------------------------------------------------------------------------
# REDIS
# Locally: set by docker-compose.yml
# Render:  provided automatically from the managed Redis service
# ------------------------------------------------------------------------------
REDIS_URL=redis://:changeme@localhost:6379/0

# ------------------------------------------------------------------------------
# AUTHENTICATION
# Use a long random string for SECRET_KEY.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# NEVER use the placeholder in production.
# ------------------------------------------------------------------------------
SECRET_KEY=REPLACE_WITH_RANDOM_64_BYTE_HEX_STRING

# Token expiry (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=900      # 15 minutes
REFRESH_TOKEN_EXPIRE_SECONDS=604800  # 7 days

# ------------------------------------------------------------------------------
# LLM PROVIDER (Phase 2+, not used in Phase 1)
# Supported providers: groq | openai
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EMBEDDING_MODEL=             # Groq has no embeddings — see EMBEDDING_PROVIDER

# OpenAI (future provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embedding provider — separate from chat LLM (Phase 5)
# Groq does not provide embeddings. Options: openai | sentence_transformers
EMBEDDING_PROVIDER=openai

# ------------------------------------------------------------------------------
# DEMO / SEEDING
# Set SEED_DEMO=true to load synthetic demo citizens on startup
# Set to false in production (real data should not be seeded)
# ------------------------------------------------------------------------------
SEED_DEMO=true

# ------------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for the backend API
# In development: include localhost frontend origin
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO    # DEBUG | INFO | WARNING | ERROR

# ------------------------------------------------------------------------------
# NEXT.JS FRONTEND
# These are read by the Next.js server at build/runtime
# NEXT_PUBLIC_ prefix = exposed to browser bundle
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# RENDER DEPLOYMENT (set these in Render dashboard, not here)
# DATABASE_URL — provided automatically by Render managed PostgreSQL
# REDIS_URL    — provided automatically by Render managed Redis
# PORT         — provided automatically by Render (default 10000)
# ------------------------------------------------------------------------------
